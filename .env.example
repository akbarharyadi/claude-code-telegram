# ─────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env` — it holds a bot token that
# grants shell access to this machine.
# ─────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────
# From @BotFather: /newbot, then copy the token it prints.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED. Comma-separated numeric Telegram user ids allowed to use the bot.
# Anyone listed here can run commands on this machine. Start the bot, send it
# /start, and it replies with your id.
ALLOWED_USER_IDS=

# Optional extra lock: only these chat ids are served (leave empty to allow any
# chat the authorized users are in). Group ids are negative.
ALLOWED_CHAT_IDS=

# Where the MCP server sends messages when no chat_id is given. Send /whoami to
# your bot to find it.
TELEGRAM_DEFAULT_CHAT_ID=

# Allow the MCP tools to address chats other than the one above. Off by default.
MCP_ALLOW_ANY_CHAT=0


# ── Claude Code ──────────────────────────────────────────────────────────
# Absolute path to the CLI. Leave empty to find `claude` on PATH.
#   Windows: C:\Users\you\.local\bin\claude.exe
#   macOS/Linux: /usr/local/bin/claude
CLAUDE_BIN=

# REQUIRED. The repository Claude works in (its cwd).
CLAUDE_WORKDIR=/absolute/path/to/your/repo

# Extra directories Claude may read and edit, space- or comma-separated.
# Useful when backend and frontend live in sibling repos.
CLAUDE_ADD_DIRS=

# Directories reachable via the /cd command. CLAUDE_WORKDIR is always included.
CLAUDE_EXTRA_WORKDIRS=

# Model override, e.g. opus / sonnet / haiku. Empty uses your Claude Code default.
CLAUDE_MODEL=
# Reasoning effort: low | medium | high | xhigh | max. Empty uses the default.
CLAUDE_EFFORT=

# How tool permissions are resolved. Headless runs cannot show you a prompt, so
# anything not covered here is refused and Claude is told so.
#   acceptEdits      file edits auto-approved, other tools need CLAUDE_ALLOWED_TOOLS
#   bypassPermissions no checks at all — only for a machine you fully control
#   plan             read-only planning, makes no changes
CLAUDE_PERMISSION_MODE=acceptEdits

# Comma-separated allowlist. `Bash` alone permits every shell command; narrow it
# with patterns like `Bash(git status:*)` if you want a tighter bot.
CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash,WebFetch,WebSearch,TodoWrite,Task,NotebookEdit

# Comma-separated denylist, applied on top. Deny wins over allow.
# A good starting point if you do NOT want the bot pushing under your identity:
#   CLAUDE_DISALLOWED_TOOLS=Bash(git push:*),Bash(gh pr create:*),Bash(gh pr comment:*)
CLAUDE_DISALLOWED_TOOLS=

# Stop a single run once it has spent this much (USD). 0 disables the cap.
CLAUDE_MAX_BUDGET_USD=0

# Kill a run that exceeds this many seconds.
CLAUDE_RUN_TIMEOUT_SECONDS=1800

# Appended to the system prompt — describe your repos so short questions land.
CLAUDE_CONTEXT_NOTE=


# ── Local state ──────────────────────────────────────────────────────────
# Sessions, downloaded attachments and logs. Defaults to ./state
STATE_DIR=
