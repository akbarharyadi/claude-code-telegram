# ─────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env` — it holds a bot token that
# grants shell access to this machine.
# ─────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────
# From @BotFather: /newbot, then copy the token it prints.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# REQUIRED. Comma-separated numeric Telegram user ids allowed to use the bot.
# Anyone listed here can run commands on this machine. Start the bot, send it
# /start, and it replies with your id.
ALLOWED_USER_IDS=

# Optional extra lock: only these chat ids are served (leave empty to allow any
# chat the authorized users are in). Group ids are negative.
ALLOWED_CHAT_IDS=

# Where the MCP server sends messages when no chat_id is given. Send /whoami to
# your bot to find it.
TELEGRAM_DEFAULT_CHAT_ID=

# Allow the MCP tools to address chats other than the one above. Off by default.
MCP_ALLOW_ANY_CHAT=0


# ── Claude Code ──────────────────────────────────────────────────────────
# Absolute path to the CLI. Leave empty to find `claude` on PATH.
#   Windows: C:\Users\you\.local\bin\claude.exe
#   macOS/Linux: /usr/local/bin/claude
CLAUDE_BIN=

# REQUIRED. The repository Claude works in (its cwd).
CLAUDE_WORKDIR=/absolute/path/to/your/repo

# Extra directories Claude may read and edit, space- or comma-separated.
# Useful when backend and frontend live in sibling repos.
CLAUDE_ADD_DIRS=

# Directories reachable via the /cd command. CLAUDE_WORKDIR is always included.
CLAUDE_EXTRA_WORKDIRS=

# Model override, e.g. opus / sonnet / haiku. Empty uses your Claude Code default.
CLAUDE_MODEL=
# Reasoning effort: low | medium | high | xhigh | max. Empty uses the default.
CLAUDE_EFFORT=

# ── Approvals: ask before doing anything, instead of auto-approving ──────
# 1 (default) = a PreToolUse hook asks you on Telegram and waits for a button
#               before any tool in CLAUDE_ASK_TOOLS runs. Claude can also ask
#               you questions with mcp__tg__ask_user, which render as buttons.
# 0           = unattended: CLAUDE_PERMISSION_MODE + CLAUDE_ALLOWED_TOOLS decide,
#               and nothing is ever asked.
TELEGRAM_APPROVALS=1

# Tools that need your approval. Each call shows the command or the file and
# a preview, with Allow / Deny / "allow every X in this run".
CLAUDE_ASK_TOOLS=Bash,Edit,Write,NotebookEdit

# Tools that run without asking. Keep this read-only, or approvals lose meaning.
CLAUDE_AUTO_ALLOW_TOOLS=Read,Grep,Glob,TodoWrite,Task,WebSearch,WebFetch,NotebookRead,BashOutput,KillShell

# How long a question waits for you before it gives up. On timeout the tool is
# DENIED, never allowed. Keep it below CLAUDE_RUN_TIMEOUT_SECONDS.
APPROVAL_WAIT_SECONDS=540
ASK_WAIT_SECONDS=540


# ── Browsing ─────────────────────────────────────────────────────────────
# 1 = pass --chrome, giving Claude the "Claude in Chrome" tools that drive the
#     browser you are already signed into. Without it those tools are absent
#     entirely and Claude falls back to a headless browser with an empty cookie
#     jar — which can never reach a page behind a login.
# Requires the Claude in Chrome extension, with the site permitted in it.
# These tools act as YOU on any site you are signed into, so they are gated by
# the approval hook. To skip the prompts, add `mcp__claude-in-chrome` to
# CLAUDE_AUTO_ALLOW_TOOLS above (a whole-server entry covers all 22 tools).
CLAUDE_ENABLE_CHROME=0

# 1 (default) = if Chrome is not running when an approved browser call is about
# to execute, start it and wait. Set to 0 to leave the browser alone.
CLAUDE_CHROME_AUTOSTART=1

# Absolute path to Chrome. Leave empty to look in the usual places for your OS.
CLAUDE_CHROME_BINARY=

# Which connected browser to drive. Normally leave this empty: the bot asks you
# on Telegram the first time, then remembers what you picked (in state/, and
# /chrome forget clears it). Set it only to pin one permanently — it overrides
# whatever you chose in the chat.
CLAUDE_CHROME_DEVICE_ID=


# ── Unattended mode — only used when TELEGRAM_APPROVALS=0 ────────────────
# How tool permissions are resolved with nobody to ask. Headless runs cannot
# show a prompt, so anything not covered here is refused and Claude is told so.
#   acceptEdits       file edits auto-approved, other tools need the allowlist
#   bypassPermissions no checks at all — only for a machine you fully control
#   plan              read-only planning, makes no changes
CLAUDE_PERMISSION_MODE=acceptEdits

# Comma-separated allowlist. `Bash` alone permits every shell command; narrow it
# with patterns like `Bash(git status:*)` if you want a tighter bot.
CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash,WebFetch,WebSearch,TodoWrite,Task,NotebookEdit

# Comma-separated denylist, applied in both modes. Deny wins over allow.
# A good starting point if you do NOT want the bot pushing under your identity:
#   CLAUDE_DISALLOWED_TOOLS=Bash(git push:*),Bash(gh pr create:*),Bash(gh pr comment:*)
CLAUDE_DISALLOWED_TOOLS=

# Stop a single run once it has spent this much (USD). 0 disables the cap.
CLAUDE_MAX_BUDGET_USD=0

# Kill a run that exceeds this many seconds.
CLAUDE_RUN_TIMEOUT_SECONDS=1800

# Appended to the system prompt — describe your repos so short questions land.
CLAUDE_CONTEXT_NOTE=


# ── Reviewing the PRs waiting on you ─────────────────────────────────────
# `/reviews` finds the open PRs that list you as a requested reviewer, and
# posts a review under your own GitHub account using the `gh` CLI. Whatever
# `gh auth status` says you are, that is who approves — check it first.
#
# Space- or comma-separated. Empty means /reviews refuses to run.
REVIEW_REPOS=

# The login whose queue to drain. Empty asks `gh` who it is.
REVIEW_LOGIN=

# quick   — Claude reads the diff, then approves or requests changes.
# deep    — the PR head is checked out into a worktree under REVIEW_CLONE_ROOT
#           and the reviewer reads real code (surrounding functions, call
#           sites, configs, tests) before judging. Needs the repo cloned
#           locally; falls back to quick otherwise. Still read-only tools.
# approve — approve without reading anything. Fast, and the review body says
#           plainly that nothing read the diff, so nobody mistakes it for you.
REVIEW_MODE=quick

# Local clone root for deep mode: expects <REVIEW_CLONE_ROOT>/<repo-name> to
# be a git clone of each reviewed repo. Empty disables deep checkouts.
REVIEW_CLONE_ROOT=

# Reviews are short, bounded jobs; low effort keeps them quick and cheap.
REVIEW_MODEL=claude-opus-5
REVIEW_EFFORT=low

REVIEW_SKIP_DRAFTS=1
REVIEW_TIMEOUT_SECONDS=600

# 1 also sweeps on a timer and reports to TELEGRAM_DEFAULT_CHAT_ID.
# Leave at 0 to keep it manual — nothing posts until you send /reviews.
REVIEW_WATCH=0
REVIEW_POLL_SECONDS=900


# ── Local state ──────────────────────────────────────────────────────────
# Sessions, downloaded attachments and logs. Defaults to ./state
STATE_DIR=

# -- Agent backend ---------------------------------------------------------
# "claude"   - the Claude Code CLI (default)
# "opencode" - OpenCode 2 (opencode2), e.g. to run GLM from a Z.AI coding plan
# AGENT_BACKEND=opencode
# OPENCODE_MODEL=zai-coding-plan/glm-5.3     # provider/model; default is GLM
# OPENCODE_PORT=42777                        # local port for the opencode2 server
# OPENCODE_BIN=opencode2                     # only if not on PATH
